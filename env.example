# =============================================================================
# AlgoPlutus - Production Environment Config Template
# Copy this to .env and fill in your real values
# NEVER commit .env to git
# =============================================================================

# --- Trading Mode ---
# Set to false only when you are READY for real live trading on Dhan
DRY_RUN=true

# --- Dhan Broker Credentials ---
# Get these from: https://console.dhan.co → API Hub
DHAN_CLIENT_ID=YOUR_DHAN_CLIENT_ID
DHAN_ACCESS_TOKEN=YOUR_DHAN_ACCESS_TOKEN

# --- Freqtrade REST API (Web UI + Risk Manager access) ---
FT_API_USERNAME=freqtrader
FT_API_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Telegram Alerts ---
# Create a bot: https://t.me/BotFather → /newbot
# Get chat ID: https://t.me/userinfobot
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# --- Risk Management ---
# Maximum portfolio drawdown per day (fraction). 0.02 = 2%
MAX_DAILY_LOSS_PCT=0.02
# Maximum single trade size (INR)
MAX_TRADE_SIZE_INR=50000

# --- Stock Universe (comma-separated Freqtrade pairs) ---
PAIR_WHITELIST=RELIANCE/INR,TCS/INR,INFY/INR,HDFCBANK/INR

# --- FreqAI Model ---
# LightGBMRegressor or XGBoostRegressor
FREQAI_MODEL=LightGBMRegressor

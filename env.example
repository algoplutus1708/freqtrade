# =============================================================================
# AlgoPlutus - Production Environment Config Template
# Copy this to .env and fill in your real values
# NEVER commit .env to git — it contains live secrets
# =============================================================================

# ── Trading Mode ──────────────────────────────────────────────────────────────
# Set to false ONLY when you're ready for REAL live trading with real money
DRY_RUN=true

# ── Dhan Broker Credentials ───────────────────────────────────────────────────
# Get these from: https://console.dhan.co → API Hub → Create Token
DHAN_CLIENT_ID=YOUR_DHAN_CLIENT_ID
DHAN_ACCESS_TOKEN=YOUR_DHAN_ACCESS_TOKEN

# ── Freqtrade REST API ────────────────────────────────────────────────────────
# Used to access the Freqtrade web UI and REST API
FT_API_USERNAME=freqtrader
FT_API_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_16_CHARS

# ── JWT & WebSocket Tokens ────────────────────────────────────────────────────
# Generate strong random values:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=GENERATE_WITH_python3_-c_import_secrets_print_secrets.token_hex_32
WS_TOKEN=GENERATE_WITH_python3_-c_import_secrets_print_secrets.token_hex_16

# ── Telegram Alerts ───────────────────────────────────────────────────────────
# Create bot: https://t.me/BotFather → /newbot
# Get your chat_id: message your bot then visit:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ── Risk Management ───────────────────────────────────────────────────────────
# Maximum portfolio drawdown allowed per day (fraction). 0.02 = 2%
MAX_DAILY_LOSS_PCT=0.02
# Maximum single trade size in INR
MAX_TRADE_SIZE_INR=50000
# Your starting capital (used for % loss calculations)
INITIAL_BALANCE_INR=100000

# ── Stock Universe ────────────────────────────────────────────────────────────
# Comma-separated Freqtrade pairs — must match SYMBOL_MAP in ccxt_proxy.py
PAIR_WHITELIST=RELIANCE/INR,TCS/INR,INFY/INR,HDFCBANK/INR,WIPRO/INR,ICICIBANK/INR,BAJFINANCE/INR,HINDUNILVR/INR,SBIN/INR,KOTAKBANK/INR

# ── FreqAI Model ──────────────────────────────────────────────────────────────
# LightGBMRegressor (default) or XGBoostRegressor
FREQAI_MODEL=LightGBMRegressor

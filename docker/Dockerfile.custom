FROM freqtradeorg/freqtrade:stable

# Install FreqAI extras + all required dependencies
USER root

RUN pip install --no-cache-dir \
    "freqtrade[freqai]" \
    lightgbm==4.3.0 \
    pandas_ta==0.3.14b \
    pytz==2024.1 \
    requests==2.31.0 \
    scikit-learn==1.4.2 \
    xgboost==2.0.3 \
    numpy==1.26.4

USER ftuser
